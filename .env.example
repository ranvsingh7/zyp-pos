# MongoDB (server-side only - never exposed to browser)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=restopos

# Auth
AUTH_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RestoPOS

# ============================================================================
# TEMPORARY — development/demo only. Do NOT enable in production.
# ============================================================================
# When true, every authenticated restaurant user (OWNER, MANAGER, CASHIER,
# WAITER) can open every implemented module regardless of their plan, so the
# whole app can be tested without provisioning a plan per venue.
#
# It does NOT bypass RBAC (a CASHIER still cannot manage staff) and it does NOT
# change anyone's role. It creates/edits no plan, subscription or snapshot, so
# setting it back to false restores plan-based access with no code or data
# change. Server-side only: it cannot be turned on from a browser.
# See src/lib/config/full-access.ts.
FULL_ACCESS_MODE=false

# ============================================================================
# Demo seed script only
# ============================================================================
# Password given to the demo staff accounts created by
# `npm run db:seed:demo:restaurant`. It is hashed with argon2id before it is
# stored and is never written to MongoDB in plaintext or printed to the console.
# The seed refuses to run without it, so no credential is ever hardcoded.
DEMO_SEED_PASSWORD=
